<UserControl x:Class="SoNexus.Views.GpuCleanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Remover driver de vídeo" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Apaga completamente o driver da placa de vídeo (como o DDU) para instalar um driver limpo. Use quando o vídeo travar, der tela preta ou ao trocar de placa."/>
        </StackPanel>

        <!-- Modo de segurança -->
        <Border x:Name="SafeBanner" DockPanel.Dock="Top" Margin="0,0,0,14" BorderThickness="1" CornerRadius="10" Padding="14,10">
            <Grid>
                <TextBlock x:Name="SafeText" TextWrapping="Wrap" Margin="0,0,300,0" VerticalAlignment="Center"/>
                <Button x:Name="SafeButton" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Safe_Click"/>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Opções -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,14,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel x:Name="OptionsPanel">
                            <TextBlock Text="1. Fabricante" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                            <ComboBox x:Name="VendorBox" SelectionChanged="Vendor_Changed">
                                <ComboBoxItem Content="NVIDIA" Tag="Nvidia"/>
                                <ComboBoxItem Content="AMD" Tag="Amd"/>
                                <ComboBoxItem Content="Intel" Tag="Intel"/>
                            </ComboBox>
                            <TextBlock x:Name="DetectedText" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                            <TextBlock Text="2. O que remover" Style="{StaticResource H2}" Margin="0,18,0,8"/>
                            <CheckBox x:Name="RestorePoint" Content="Criar ponto de restauração antes" IsChecked="True" Margin="0,0,0,8"/>
                            <CheckBox x:Name="IncludeAudio" Content="Áudio HDMI/DisplayPort da placa" IsChecked="True" Margin="0,0,0,8" Click="IncludeAudio_Click"/>
                            <CheckBox x:Name="RemoveServices" Content="Serviços do fabricante" IsChecked="True" Margin="0,0,0,8"/>
                            <CheckBox x:Name="RemovePanel" Content="Painel de controle (app da Store)" IsChecked="True" Margin="0,0,0,8"/>
                            <CheckBox x:Name="RemoveFolders" Content="Pastas e caches de shader" IsChecked="True" Margin="0,0,0,8"/>
                            <CheckBox x:Name="BlockUpdate" Content="Impedir o Windows Update de reinstalar driver" IsChecked="True"/>
                            <TextBlock x:Name="AutoInstallText" Style="{StaticResource Muted}" Margin="26,4,0,0" TextWrapping="Wrap"/>
                            <Button x:Name="UnblockButton" Content="Liberar instalação automática de novo" HorizontalAlignment="Left"
                                    Margin="26,6,0,0" Click="Unblock_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="3. Remover" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="A tela vai piscar e ficar em baixa resolução até você instalar o driver novo. Feche jogos e programas antes."/>
                            <Button x:Name="CleanButton" Content="Remover driver de vídeo" Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,0,8" Click="Clean_Click"/>
                            <Button x:Name="RebootButton" Content="Reiniciar o PC agora" Click="Reboot_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Itens e registro -->
            <DockPanel Grid.Column="1">
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="14,10" Height="170">
                    <TextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                </Border>
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Programas do fabricante" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,8" TextWrapping="Wrap"
                                   Text="Opcional: desinstale antes (NVIDIA App, AMD Software...). Abre o desinstalador de cada um."/>
                        <ItemsControl x:Name="ProgramList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        <Button Content="Desinstalar" HorizontalAlignment="Right" Padding="12,4" Click="UninstallProgram_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoProgramsText" Style="{StaticResource Muted}" Text="Nenhum programa do fabricante encontrado."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Pacotes de driver que serão apagados" Style="{StaticResource H2}"/>
                        <TextBlock x:Name="PackageStatus" DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,2,0,8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="PackageList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected}" Margin="0,4">
                                            <TextBlock>
                                                <Run Text="{Binding Driver, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text="{Binding InfName, Mode=OneWay}"/> · <Run Text="{Binding ClassText, Mode=OneWay}"/> ·
                                                <Run Text="{Binding Version, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/>
                                            </TextBlock>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>

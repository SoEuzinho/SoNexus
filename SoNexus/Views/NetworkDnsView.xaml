<UserControl x:Class="SoNexus.Views.NetworkDnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="DNS" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="O DNS transforma nomes de sites em endereços. Um DNS rápido abre páginas mais rápido; alguns também bloqueiam sites maliciosos."/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Margin="0,0,14,0">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="DNS ATUAL" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="CurrentDns" Text="—" FontSize="22" FontWeight="Light" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="CurrentAdapter" Style="{StaticResource Muted}"/>
                        <StackPanel x:Name="DnsBar" Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Testar velocidade" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="Test_Click"/>
                            <Button Content="Voltar ao automático" Margin="0,0,8,0" Click="Reset_Click"/>
                            <Button Content="Limpar cache DNS" Click="Flush_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="DnsStatus" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <ItemsControl x:Name="TestList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16,10">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Server}" Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MsText}" FontSize="18" FontWeight="Light" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        <Button Content="Usar" Padding="12,5" Tag="{Binding}" Click="Use_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" Margin="0,0,14,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,14,16,8">
                        <TextBlock Text="Sites acessados recentemente (cache DNS)" Style="{StaticResource H2}"/>
                        <TextBlock x:Name="CacheStatus" Style="{StaticResource Muted}" Margin="0,2,0,8"/>
                        <Grid>
                            <TextBox x:Name="CacheFilter" TextChanged="CacheFilter_Changed"/>
                            <TextBlock x:Name="CacheHint" Text="Filtrar domínio" IsHitTestVisible="False" Style="{StaticResource Muted}" Margin="11,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                    <DataGrid x:Name="CacheGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Domínio" Binding="{Binding Entry, Mode=OneWay}" Width="*"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Type, Mode=OneWay}" Width="70"/>
                            <DataGridTextColumn Header="Resposta" Binding="{Binding Data, Mode=OneWay}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>

<UserControl x:Class="SoNexus.Views.HardwareBenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style x:Key="Big" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,0">
            <TextBlock Text="Benchmark de placa de vídeo, memória e disco" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,16" TextWrapping="Wrap"
                       Text="Mede a força de computação da placa de vídeo, a velocidade da memória de vídeo, da RAM e do disco. Funciona com NVIDIA, AMD e Intel. Feche jogos e programas pesados antes."/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <TextBlock x:Name="PhaseText" Text="Pronto para começar" Style="{StaticResource H2}"/>
                        <TextBlock x:Name="LiveText" HorizontalAlignment="Right" Style="{StaticResource Muted}" FontSize="13"/>
                    </Grid>
                    <ProgressBar x:Name="PhaseBar" Style="{StaticResource Meter}" Margin="0,10,0,14" Maximum="100"/>
                    <WrapPanel x:Name="StartBar">
                        <Button Content="Testar tudo" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="All_Click"/>
                        <Button Content="Só placa de vídeo" Margin="0,0,8,0" Click="Gpu_Click"/>
                        <Button Content="Só memória RAM" Margin="0,0,8,0" Click="Ram_Click"/>
                        <Button Content="Só disco" Margin="0,0,8,0" Click="Disk_Click"/>
                    </WrapPanel>
                    <Button x:Name="StopButton" Content="Parar" Visibility="Collapsed" HorizontalAlignment="Left" Click="Stop_Click"/>
                </StackPanel>
            </Border>

            <UniformGrid Columns="2">
                <Border Style="{StaticResource Card}" Margin="0,0,14,14">
                    <StackPanel>
                        <TextBlock Text="PLACA DE VÍDEO · COMPUTAÇÃO" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="GpuName" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="GpuScore" Text="—" Style="{StaticResource Big}"/>
                        <TextBlock x:Name="GpuDetail" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="MEMÓRIA DE VÍDEO (VRAM)" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="VramScore" Text="—" Style="{StaticResource Big}"/>
                        <TextBlock x:Name="VramDetail" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,14,14">
                    <StackPanel>
                        <TextBlock Text="MEMÓRIA RAM" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="RamScore" Text="—" Style="{StaticResource Big}"/>
                        <TextBlock x:Name="RamDetail" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="DISCO DO WINDOWS" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="DiskScore" Text="—" Style="{StaticResource Big}"/>
                        <TextBlock x:Name="DiskDetail" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="Para medir se as peças ficam estáveis por muito tempo (e não só a velocidade), use a aba Stress test."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>

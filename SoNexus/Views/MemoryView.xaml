<UserControl x:Class="SoNexus.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SoNexus.Controls"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
        <Style x:Key="Big" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <DataTemplate x:Key="KeyValue">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Key}" Style="{StaticResource Muted}" FontSize="13"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,0">
            <TextBlock Text="Memória" Style="{StaticResource H1}"/>
            <TextBlock x:Name="Subtitle" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,20"/>

            <Border x:Name="Advice" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,10" Visibility="Collapsed">
                <TextBlock x:Name="AdviceText" TextWrapping="Wrap"/>
            </Border>

            <!-- Números principais -->
            <UniformGrid Columns="4">
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="EM USO" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="UsedText" Text="—" Style="{StaticResource Big}"/>
                        <TextBlock x:Name="UsedDetail" Style="{StaticResource Muted}"/>
                        <c:LineChart x:Name="UsageChart" Height="60" Margin="0,10,0,0" FixedMin="0" FixedMax="100" Capacity="90"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="DISPONÍVEL" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="AvailText" Text="—" Style="{StaticResource Big}"/>
                        <TextBlock x:Name="AvailDetail" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="CONFIRMADA (COMMIT)" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="CommitText" Text="—" Style="{StaticResource Big}"/>
                        <TextBlock x:Name="CommitDetail" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="LATÊNCIA DA RAM" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="LatencyText" Text="—" Style="{StaticResource Big}"/>
                        <TextBlock x:Name="LatencyDetail" Style="{StaticResource Muted}" TextWrapping="Wrap" Text="Clique em Medir abaixo"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Composição -->
            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="COMO A RAM ESTÁ DIVIDIDA" Style="{StaticResource Label}" Margin="0,0,0,10"/>
                    <Border CornerRadius="4" ClipToBounds="True" Height="16">
                        <Grid x:Name="CompositionBar">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ColUsed" Width="1*"/>
                                <ColumnDefinition x:Name="ColModified" Width="0*"/>
                                <ColumnDefinition x:Name="ColStandby" Width="0*"/>
                                <ColumnDefinition x:Name="ColFree" Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="White"/>
                            <Border Grid.Column="1" Background="#8C8C8C"/>
                            <Border Grid.Column="2" Background="#3D3D3D"/>
                            <Border Grid.Column="3" Background="#151515"/>
                        </Grid>
                    </Border>
                    <WrapPanel Margin="0,10,0,0">
                        <TextBlock x:Name="LegendUsed" Margin="0,0,24,0"/>
                        <TextBlock x:Name="LegendModified" Margin="0,0,24,0" Foreground="#8C8C8C"/>
                        <TextBlock x:Name="LegendStandby" Margin="0,0,24,0" Foreground="#6E6E6E"/>
                        <TextBlock x:Name="LegendFree" Foreground="#5C5C5C"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Em espera = cache de arquivos (é liberado sozinho quando um programa precisa). Modificada = dados esperando para ir ao disco. Livre = sem uso nenhum."/>
                </StackPanel>
            </Border>

            <UniformGrid Columns="2">
                <!-- Detalhes -->
                <Border Style="{StaticResource Card}" Margin="0,0,12,12" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="DETALHES" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="DetailList" ItemTemplate="{StaticResource KeyValue}"/>
                    </StackPanel>
                </Border>
                <!-- Pentes -->
                <Border Style="{StaticResource Card}" Margin="0,0,12,12" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="PENTES INSTALADOS" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="ModuleList" ItemTemplate="{StaticResource KeyValue}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Teste de latência e velocidade -->
            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <StackPanel Margin="0,0,160,0">
                            <TextBlock Text="LATÊNCIA E VELOCIDADE" Style="{StaticResource Label}"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Text="Mede o tempo para buscar um dado em cada nível: caches da CPU (L1, L2, L3) e a RAM. Menos nanossegundos = mais rápido. Feche jogos antes; leva uns 10 segundos."/>
                        </StackPanel>
                        <Button x:Name="BenchButton" Content="Medir" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="Bench_Click"/>
                    </Grid>
                    <UniformGrid Columns="4" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Leitura" Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="ReadText" Text="—" FontSize="22" FontWeight="Light"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Escrita" Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="WriteText" Text="—" FontSize="22" FontWeight="Light"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Cópia" Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="CopyText" Text="—" FontSize="22" FontWeight="Light"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Teórico do seu PC" Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="TheoryText" Text="—" FontSize="22" FontWeight="Light"/>
                        </StackPanel>
                    </UniformGrid>
                    <ItemsControl x:Name="LatencyList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Size}" Style="{StaticResource Muted}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Level}"/>
                                    <Border Grid.Column="2" Height="6" CornerRadius="3" Background="White" HorizontalAlignment="Left"
                                            Width="{Binding Bar}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Text}" TextAlignment="Right" FontFamily="Consolas"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="BenchStatus" Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Liberar memória -->
            <Grid Margin="0,0,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="LIBERAR MEMÓRIA" Style="{StaticResource Label}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,12" TextWrapping="Wrap"
                                   Text="Libera RAM de programas ociosos e o cache do Windows. Útil antes de abrir um jogo pesado."/>
                        <WrapPanel>
                            <Button x:Name="FullButton" Content="Limpeza completa" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Click="Full_Click"/>
                            <Button x:Name="TrimButton" Content="Liberar dos processos" Margin="0,0,8,8" Click="Trim_Click"/>
                            <Button x:Name="StandbyButton" Content="Limpar cache (Standby)" Margin="0,0,8,8" Click="Standby_Click"/>
                        </WrapPanel>
                        <TextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" Height="110"
                                 FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="PROGRAMAS QUE MAIS USAM RAM" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="ProcessList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,80,0"/>
                                        <TextBlock Text="{Binding Display}" Style="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

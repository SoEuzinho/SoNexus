<UserControl x:Class="SoNexus.Views.GameAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,0">
            <TextBlock Text="Seu PC para jogos" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,20" TextWrapping="Wrap"
                       Text="Quanto a placa de vídeo e o processador rendem, quem limita o FPS em cada resolução (gargalo) e o que dá para melhorar."/>

            <UniformGrid Columns="3">
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="PLACA DE VÍDEO" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="GpuName" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar x:Name="GpuBar" Style="{StaticResource Meter}" Foreground="White" Maximum="700" Margin="0,10,0,6"/>
                        <TextBlock x:Name="GpuText" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="PROCESSADOR" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="CpuName" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar x:Name="CpuBar" Style="{StaticResource Meter}" Foreground="White" Maximum="220" Margin="0,10,0,6"/>
                        <TextBlock x:Name="CpuText" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="MONITOR E MEMÓRIA" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="MonitorText" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <TextBlock x:Name="RamText" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="GARGALO POR RESOLUÇÃO" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Gargalo é a peça que segura as outras. A cada quadro, o processador prepara a cena (física, IA, comandos) e a placa de vídeo desenha. O FPS final é o da peça mais lenta: se o processador só prepara 80 quadros, uma placa capaz de 150 fica parada metade do tempo. Em resoluções maiores a placa trabalha mais e o processador pesa menos."/>
                    <ItemsControl x:Name="BottleneckList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Resolution}" FontSize="16" FontWeight="Light" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                        <TextBlock Text="LIMITE" Style="{StaticResource Label}"/>
                                        <TextBlock Text="{Binding Limit}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding GpuUseText}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                        <ProgressBar Style="{StaticResource Meter}" Foreground="White" Maximum="100" Value="{Binding GpuUse, Mode=OneWay}" Margin="0,2,0,6"/>
                                        <TextBlock Text="{Binding CpuUseText}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                        <ProgressBar Style="{StaticResource Meter}" Foreground="White" Maximum="100" Value="{Binding CpuUse, Mode=OneWay}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding Text}" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Top"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Estimativa pelo desempenho médio de cada peça em reviews. Para medir o gargalo real num jogo, abra Jogos › FPS ao vivo durante a partida: ele mostra o uso da placa e do processador e diz quem está segurando."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="O QUE ESTÁ SEGURANDO O SEU PC" Style="{StaticResource Label}" Margin="0,0,0,10"/>
                    <ItemsControl x:Name="TipList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource MutedBrush}" Padding="6,1" VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Impact}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Corrigir" Padding="12,4" VerticalAlignment="Center" Tag="{Binding}" Click="Fix_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Fix}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="TipStatus" Style="{StaticResource Muted}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="PROBLEMAS NOS JOGOS" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Jogos que fecharam sozinhos nos últimos 30 dias (registrado pelo Windows), bibliotecas que faltam, instalações quebradas e discos cheios."/>
                    <ItemsControl x:Name="ProblemList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource MutedBrush}" Padding="6,1" VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Severity}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="ProblemStatus" Style="{StaticResource Muted}" Text="Procurando..."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

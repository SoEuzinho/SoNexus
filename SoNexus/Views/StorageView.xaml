<UserControl x:Class="SoNexus.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
        <DataTemplate x:Key="KeyValue">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Key}" Style="{StaticResource Muted}" FontSize="13"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,14,16">
            <StackPanel Margin="0,0,140,0">
                <TextBlock Text="Armazenamento" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Saúde real de cada SSD, NVMe e HD pelo SMART, vida útil, setores defeituosos e uma varredura de superfície que só lê o disco."/>
            </StackPanel>
            <Button Content="Atualizar" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Reload_Click"/>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Lista de discos -->
            <ListBox x:Name="DiskList" Background="Transparent" BorderThickness="0" Margin="0,0,14,0" SelectionChanged="Disk_Selected"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bd" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,10" Cursor="Hand">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,80,0"/>
                                <Border x:Name="badge" HorizontalAlignment="Right" CornerRadius="4" Padding="6,1" BorderThickness="1" BorderBrush="{StaticResource MutedBrush}">
                                    <TextBlock x:Name="verdict" Text="{Binding Verdict}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding LifeText}" Foreground="{StaticResource TextBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Verdict}" Value="Crítico">
                                <Setter TargetName="badge" Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                <Setter TargetName="verdict" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Verdict}" Value="Atenção">
                                <Setter TargetName="badge" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="verdict" Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Detalhes -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Detail" Margin="0,0,14,0" Visibility="Collapsed">
                    <Border x:Name="VerdictCard" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="VerdictTitle" FontSize="26" FontWeight="Light"/>
                            <ItemsControl x:Name="IssueList" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="0,2" Foreground="{StaticResource MutedBrush}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <UniformGrid Columns="4" Margin="0,0,0,0">
                        <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="VIDA ÚTIL" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="LifeText" Text="—" FontSize="26" FontWeight="Light"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="TEMPERATURA" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="TempText" Text="—" FontSize="26" FontWeight="Light"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="TEMPO LIGADO" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="HoursText" Text="—" FontSize="26" FontWeight="Light"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="TOTAL ESCRITO" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="WrittenText" Text="—" FontSize="26" FontWeight="Light"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="INFORMAÇÕES" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="InfoList" ItemTemplate="{StaticResource KeyValue}"/>
                        </StackPanel>
                    </Border>

                    <!-- Varredura -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="VARREDURA DE SETORES" Style="{StaticResource Label}"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,12" TextWrapping="Wrap"
                                       Text="Lê o disco procurando partes ilegíveis (setores defeituosos) ou muito lentas. Só leitura: nada é apagado ou gravado. Rápida: ~3 GB espalhados (1-2 min). Completa: o disco inteiro (SSD: minutos, HD: horas)."/>
                            <StackPanel x:Name="ScanBar" Orientation="Horizontal">
                                <Button Content="Varredura rápida" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="QuickScan_Click"/>
                                <Button Content="Varredura completa" Margin="0,0,8,0" Click="FullScan_Click"/>
                            </StackPanel>
                            <Button x:Name="StopButton" Content="Parar" HorizontalAlignment="Left" Visibility="Collapsed" Click="Stop_Click"/>
                            <ProgressBar x:Name="ScanProgressBar" Style="{StaticResource Meter}" Margin="0,14,0,8"/>
                            <TextBlock x:Name="ScanStatus" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                            <DataGrid x:Name="BadGrid" Margin="0,10,0,0" MaxHeight="220" Visibility="Collapsed">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Posição" Binding="{Binding OffsetText, Mode=OneWay}" Width="*"/>
                                    <DataGridTextColumn Header="Problema" Binding="{Binding Kind, Mode=OneWay}" Width="160"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ATRIBUTOS SMART" Style="{StaticResource Label}" Margin="18,16,0,8"/>
                            <DataGrid x:Name="SmartGrid" MaxHeight="420">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id, Mode=OneWay}" Width="50"/>
                                    <DataGridTextColumn Header="Atributo" Binding="{Binding Name, Mode=OneWay}" Width="*"/>
                                    <DataGridTextColumn Header="Atual" Binding="{Binding Current, Mode=OneWay}" Width="110"/>
                                    <DataGridTextColumn Header="Pior" Binding="{Binding Worst, Mode=OneWay}" Width="90"/>
                                    <DataGridTextColumn Header="Valor bruto" Binding="{Binding Raw, Mode=OneWay}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>

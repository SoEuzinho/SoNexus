<UserControl x:Class="SoNexus.Views.HiddenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Itens ocultos" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"
                       Text="O que está instalado no Windows mas não aparece nas telas normais."/>
        </StackPanel>

        <TabControl>
            <!-- Programas -->
            <TabItem Header="Programas instalados">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="260" Margin="0,0,14,0">
                                <TextBox x:Name="ProgramFilter" TextChanged="ProgramFilter_Changed"/>
                                <TextBlock x:Name="ProgramHint" Text="Filtrar por nome ou editor" IsHitTestVisible="False"
                                           Style="{StaticResource Muted}" Margin="11,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <CheckBox x:Name="OnlyHidden" Content="Mostrar só os ocultos" IsChecked="True"
                                      VerticalAlignment="Center" Click="ProgramFilter_Changed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="ProgramStatus" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Button Content="Desinstalar" Style="{StaticResource PrimaryButton}" Click="Uninstall_Click"/>
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource Card}" Padding="0">
                        <DataGrid x:Name="ProgramGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nome" Binding="{Binding Name, Mode=OneWay}" Width="*"/>
                                <DataGridTextColumn Header="Versão" Binding="{Binding Version, Mode=OneWay}" Width="120"/>
                                <DataGridTextColumn Header="Editor" Binding="{Binding Publisher, Mode=OneWay}" Width="180"/>
                                <DataGridTextColumn Header="Instalado em" Binding="{Binding InstallDate, Mode=OneWay}" Width="100"/>
                                <DataGridTextColumn Header="Tamanho" Binding="{Binding Size, Mode=OneWay}" Width="90"/>
                                <DataGridTextColumn Header="Visibilidade" Binding="{Binding Visibility, Mode=OneWay}" Width="210"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- Dispositivos fantasmas -->
            <TabItem Header="Dispositivos fantasmas">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock x:Name="DeviceStatus" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,330,0"
                                   Text="Aparelhos que já foram conectados e deixaram drivers para trás (pendrives, GPUs antigas, controles...)."/>
                        <StackPanel x:Name="DeviceBar" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Atualizar" Margin="0,0,8,0" Click="ReloadDevices_Click"/>
                            <Button Content="Remover selecionados" Style="{StaticResource PrimaryButton}" Click="RemoveDevices_Click"/>
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource Card}" Padding="0">
                        <DataGrid x:Name="DeviceGrid" SelectionMode="Extended">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Dispositivo" Binding="{Binding Display, Mode=OneWay}" Width="*"/>
                                <DataGridTextColumn Header="Classe" Binding="{Binding Class, Mode=OneWay}" Width="160"/>
                                <DataGridTextColumn Header="ID da instância" Binding="{Binding InstanceId, Mode=OneWay}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- Tarefas ocultas -->
            <TabItem Header="Tarefas agendadas ocultas">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock x:Name="TaskStatus" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"
                                   Text="Tarefas marcadas como ocultas no Agendador de Tarefas."/>
                        <CheckBox x:Name="TaskShowMicrosoft" Content="Mostrar tarefas da Microsoft" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Click="TaskFilter_Changed"/>
                    </Grid>
                    <Border Style="{StaticResource Card}" Padding="0">
                        <DataGrid x:Name="TaskGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tarefa" Binding="{Binding Name, Mode=OneWay}" Width="220"/>
                                <DataGridTextColumn Header="Pasta" Binding="{Binding Path, Mode=OneWay}" Width="220"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding StateName, Mode=OneWay}" Width="100"/>
                                <DataGridTextColumn Header="Executa" Binding="{Binding Command, Mode=OneWay}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>

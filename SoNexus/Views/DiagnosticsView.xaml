<UserControl x:Class="SoNexus.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <Style x:Key="WrapCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Diagnóstico de erros" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"
                           Text="Lê os registros do Windows e explica telas azuis, travamentos e erros de hardware."/>
            </StackPanel>
            <StackPanel x:Name="AnalyzeBar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ComboBox x:Name="PeriodBox" Width="130" SelectedIndex="1" Margin="0,0,8,0">
                    <ComboBoxItem Content="Últimos 7 dias" Tag="7"/>
                    <ComboBoxItem Content="Últimos 30 dias" Tag="30"/>
                    <ComboBoxItem Content="Últimos 90 dias" Tag="90"/>
                </ComboBox>
                <Button Content="Analisar" Style="{StaticResource PrimaryButton}" Click="Analyze_Click"/>
            </StackPanel>
        </Grid>

        <Border x:Name="Verdict" DockPanel.Dock="Top" Margin="0,0,14,14" BorderThickness="1" CornerRadius="10" Padding="14,10"
                Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}">
            <TextBlock x:Name="VerdictText" TextWrapping="Wrap" FontWeight="SemiBold" Text="Analisando..."/>
        </Border>

        <ItemsControl x:Name="Cards" DockPanel.Dock="Top">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="6"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,14,14" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{Binding Value}" FontSize="30" FontWeight="SemiBold" Foreground="{Binding Brush}"/>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TabControl>
            <TabItem Header="Telas azuis e desligamentos">
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,14,0">
                    <DataGrid x:Name="CrashGrid" RowHeight="NaN" MinRowHeight="34">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Quando" Binding="{Binding TimeText, Mode=OneWay}" Width="130"/>
                            <DataGridTextColumn Header="O que aconteceu" Binding="{Binding Title, Mode=OneWay}" Width="300" ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Causa provável e o que fazer" Binding="{Binding Detail, Mode=OneWay}" Width="*" ElementStyle="{StaticResource WrapCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
            <TabItem Header="Hardware, vídeo e disco">
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,14,0">
                    <DataGrid x:Name="HardwareGrid" RowHeight="NaN" MinRowHeight="34">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Quando" Binding="{Binding TimeText, Mode=OneWay}" Width="130"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Source, Mode=OneWay}" Width="90"/>
                            <DataGridTextColumn Header="O que aconteceu" Binding="{Binding Title, Mode=OneWay}" Width="260" ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Detalhes" Binding="{Binding Detail, Mode=OneWay}" Width="*" ElementStyle="{StaticResource WrapCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
            <TabItem Header="Programas que travaram">
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,14,0">
                    <DataGrid x:Name="AppGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Programa" Binding="{Binding Name, Mode=OneWay}" Width="260"/>
                            <DataGridTextColumn Header="Vezes" Binding="{Binding Count, Mode=OneWay}" Width="70"/>
                            <DataGridTextColumn Header="Última vez" Binding="{Binding LastText, Mode=OneWay}" Width="130"/>
                            <DataGridTextColumn Header="Detalhe" Binding="{Binding Detail, Mode=OneWay}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
            <TabItem Header="Dispositivos com problema">
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,14,0">
                    <DataGrid x:Name="DeviceGrid" RowHeight="NaN" MinRowHeight="34">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Dispositivo" Binding="{Binding Name, Mode=OneWay}" Width="260"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Class, Mode=OneWay}" Width="120"/>
                            <DataGridTextColumn Header="O que significa" Binding="{Binding Explanation, Mode=OneWay}" Width="*" ElementStyle="{StaticResource WrapCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
            <TabItem Header="Todos os erros do sistema">
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,14,0">
                    <DataGrid x:Name="SystemGrid" RowHeight="NaN" MinRowHeight="34">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Origem · ID" Binding="{Binding Name, Mode=OneWay}" Width="230"/>
                            <DataGridTextColumn Header="Vezes" Binding="{Binding Count, Mode=OneWay}" Width="70"/>
                            <DataGridTextColumn Header="Última vez" Binding="{Binding LastText, Mode=OneWay}" Width="130"/>
                            <DataGridTextColumn Header="Mensagem" Binding="{Binding Detail, Mode=OneWay}" Width="*" ElementStyle="{StaticResource WrapCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
            <TabItem Header="Ferramentas de reparo">
                <DockPanel Margin="0,0,14,0">
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <WrapPanel x:Name="ToolBar">
                                <Button Content="Verificar arquivos do Windows (SFC)" Margin="0,0,8,8" Click="Sfc_Click"/>
                                <Button Content="Reparar imagem do Windows (DISM)" Margin="0,0,8,8" Click="Dism_Click"/>
                                <Button Content="Verificar disco C: (chkdsk)" Margin="0,0,8,8" Click="Chkdsk_Click"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                       Text="Ordem recomendada quando o Windows está com erros estranhos: DISM primeiro, depois SFC. Cada um leva de 5 a 20 minutos."/>
                            <TextBlock x:Name="ToolProgress" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14,10">
                        <TextBox x:Name="ToolLog" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>

<Window x:Class="SoNexus.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bem-vindo ao SoNexus" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" SourceInitialized="OnSourceInitialized" Closing="OnClosing">
    <!-- O botão "Começar" fica sempre visível embaixo; o resto rola em telas pequenas ou com zoom alto. -->
    <DockPanel Margin="0,0,0,22">
        <Grid DockPanel.Dock="Bottom" Margin="40,14,40,0">
            <TextBlock x:Name="FooterText" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,170,0"
                       Text="Aceite os termos para começar. As outras escolhas dá para mudar depois em Configurações."/>
            <Button x:Name="StartButton" Content="Começar" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Padding="28,8"
                    Click="Start_Click" IsDefault="True" IsEnabled="False"/>
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,30,40,0">
        <StackPanel Orientation="Horizontal">
            <Viewbox Width="40" Height="44" VerticalAlignment="Center">
                <Path Data="{StaticResource SoStudioMark}" Fill="White" Width="100" Height="100"/>
            </Viewbox>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Bem-vindo ao SoNexus" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="por SoStudio · criado por SoEuzinho" Style="{StaticResource Muted}"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,22,0,18"
                   Text="Tudo do seu PC num lugar só: temperaturas e peças, otimização do Windows, drivers, FPS e desempenho em jogos, rede, áudio, diagnóstico e iluminação RGB."/>

        <UniformGrid Columns="2" Margin="0,0,0,8">
            <StackPanel Margin="0,0,14,14">
                <TextBlock FontWeight="SemiBold"><Run Text="&#xE950;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/><Run Text="  Hardware"/></TextBlock>
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="Sensores, saúde dos discos e consumo de energia."/>
            </StackPanel>
            <StackPanel Margin="0,0,0,14">
                <TextBlock FontWeight="SemiBold"><Run Text="&#xE7FC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/><Run Text="  Jogos"/></TextBlock>
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="FPS ao vivo, gargalo, benchmarks e stress test."/>
            </StackPanel>
            <StackPanel Margin="0,0,14,14">
                <TextBlock FontWeight="SemiBold"><Run Text="&#xE9F5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/><Run Text="  Otimização"/></TextBlock>
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="Ajustes do Windows reversíveis, com backup automático."/>
            </StackPanel>
            <StackPanel Margin="0,0,0,14">
                <TextBlock FontWeight="SemiBold"><Run Text="&#xE781;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/><Run Text="  Iluminação"/></TextBlock>
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="Efeitos RGB nas ventoinhas, placa e memória."/>
            </StackPanel>
        </UniformGrid>

        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="COMO VOCÊ QUER USAR" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
                <CheckBox x:Name="TrayBox" Content="Continuar rodando perto do relógio ao fechar (ventoinhas, RGB e avisos)" IsChecked="True" Margin="0,0,0,8"/>
                <CheckBox x:Name="AlertBox" Content="Avisar quando o PC esquentar demais" IsChecked="True" Margin="0,0,0,8"/>
                <CheckBox x:Name="StartupBox" Content="Iniciar com o Windows"/>
                <TextBlock x:Name="StartupHint" Style="{StaticResource Muted}" Margin="26,2,0,10" TextWrapping="Wrap"/>
                <!-- Consentimento explícito (LGPD): começa desmarcado, a pessoa escolhe. -->
                <CheckBox x:Name="OnlineBox" Content="Permitir consultas na internet (Steam, ipinfo.io, servidores da Valve)"/>
                <TextBlock Style="{StaticResource Muted}" Margin="26,2,0,0" TextWrapping="Wrap"
                           Text="Para estimar o FPS dos jogos, mostrar seu IP/operadora e a lista de servidores. Nenhum dado seu é enviado ao SoNexus; esses serviços só veem seu IP, como em qualquer site."/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,22" BorderBrush="#555555">
            <StackPanel>
                <TextBlock Text="TERMOS DE USO E PRIVACIDADE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="O SoNexus é gratuito e fornecido como está, sem garantia. Otimizações, drivers, overclock, ventoinhas e testes de estresse mexem no seu PC: você decide e é responsável pelo que aplicar. Seus dados ficam só no seu computador."/>
                <Button Content="Ler os termos completos" HorizontalAlignment="Left" Margin="0,0,0,10" Click="ReadTerms_Click"/>
                <CheckBox x:Name="AcceptBox" Content="Li e aceito os Termos de Uso e a Política de Privacidade" FontWeight="SemiBold" Click="Accept_Click"/>
            </StackPanel>
        </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

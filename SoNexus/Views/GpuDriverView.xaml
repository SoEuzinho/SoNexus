<UserControl x:Class="SoNexus.Views.GpuDriverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,14,16">
            <StackPanel Margin="0,0,160,0">
                <TextBlock Text="Driver da placa de vídeo" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Compara o seu driver com o mais recente no site oficial da NVIDIA, AMD ou Intel e instala com um clique."/>
            </StackPanel>
            <Button x:Name="CheckButton" Content="Verificar de novo" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Click="Check_Click"/>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,0,14,0">
            <CheckBox x:Name="CleanBox" Content="Instalação limpa da NVIDIA (apaga as configurações do Painel de Controle NVIDIA)" Margin="0,0,0,6"/>
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="Os arquivos são baixados direto dos servidores oficiais (nvidia.com, amd.com) e ficam em %LocalAppData%\SoNexus\Drivers. A tela pode piscar durante a instalação; feche jogos antes."/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="GpuList" Margin="0,0,14,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,18">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Margin="0,0,220,0">
                                        <TextBlock Text="{Binding Vendor}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock Text="{Binding Gpu}" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
                                            Instalado: <Run Text="{Binding Installed, Mode=OneWay}" Foreground="White"/>   ·   Mais recente: <Run Text="{Binding Latest, Mode=OneWay, TargetNullValue='—'}" Foreground="White"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="Baixar e instalar" Style="{StaticResource PrimaryButton}" Tag="{Binding}" Click="Install_Click" Margin="0,0,0,8"/>
                                        <Button Content="Página oficial" Tag="{Binding}" Click="Site_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>

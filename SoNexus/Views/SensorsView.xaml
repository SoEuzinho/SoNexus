<UserControl x:Class="SoNexus.Views.SensorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Sensores" Style="{StaticResource H1}"/>
                <TextBlock x:Name="Status" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" Text="Aguardando leitura..."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Grid Width="260" Margin="0,0,10,0">
                    <TextBox x:Name="FilterBox" TextChanged="Filter_Changed"/>
                    <TextBlock x:Name="FilterHint" Text="Filtrar (ex.: temperatura, fan, GPU)" IsHitTestVisible="False"
                               Style="{StaticResource Muted}" Margin="11,0,0,0" VerticalAlignment="Center"/>
                </Grid>
                <Button Content="Zerar mín/máx" Click="Reset_Click"/>
            </StackPanel>
        </Grid>

        <v:SensorDriverBanner DockPanel.Dock="Top" xmlns:v="clr-namespace:SoNexus.Views"/>

        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="SensorGrid">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{StaticResource AccentBrush}" Margin="12,14,0,6"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Sensor" Binding="{Binding Name, Mode=OneWay}" Width="*"/>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Type, Mode=OneWay}" Width="130"/>
                    <DataGridTextColumn Header="Atual" Binding="{Binding Value, Mode=OneWay}" Width="120"/>
                    <DataGridTextColumn Header="Mínimo" Binding="{Binding Min, Mode=OneWay}" Width="120"/>
                    <DataGridTextColumn Header="Máximo" Binding="{Binding Max, Mode=OneWay}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>

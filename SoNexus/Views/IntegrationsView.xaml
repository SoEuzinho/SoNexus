<UserControl x:Class="SoNexus.Views.IntegrationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,0">
            <Grid>
                <StackPanel Margin="0,0,180,0">
                    <TextBlock Text="Integrações" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="Summary" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,20" TextWrapping="Wrap"
                               Text="Procurando o que está instalado no seu PC..."/>
                </StackPanel>
                <Button Content="Atualizar" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0" Click="Refresh_Click"/>
            </Grid>

            <ItemsControl x:Name="Cards">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,14,14" Padding="20,18">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top">
                                    <Border Width="42" Height="42" CornerRadius="21" Background="#151515" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="10" Padding="10,3" BorderThickness="1" BorderBrush="{Binding StatusBrush}">
                                        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{Binding StatusBrush}"/>
                                    </Border>
                                </Grid>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,4"/>
                                <Button DockPanel.Dock="Bottom" Content="{Binding Action}" Tag="{Binding}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="Card_Click"/>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap" MinHeight="54"/>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>

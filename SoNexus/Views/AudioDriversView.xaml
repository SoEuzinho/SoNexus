<UserControl x:Class="SoNexus.Views.AudioDriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Drivers e programas de áudio" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"
                       Text="Placas de som, drivers instalados e programas que mexem no áudio (mixers, efeitos, cabos virtuais)."/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ItemsControl x:Name="SoftwareList" Margin="0,0,14,6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="14,12">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Status}" HorizontalAlignment="Right" Style="{StaticResource Muted}"/>
                                </Grid>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,0,14,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="DriverTitle" Text="Drivers de áudio" Style="{StaticResource H2}" Margin="16,14,0,8"/>
                    <DataGrid x:Name="DriverGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Dispositivo" Binding="{Binding Device, Mode=OneWay}" Width="*"/>
                            <DataGridTextColumn Header="Fabricante do driver" Binding="{Binding Provider, Mode=OneWay}" Width="220"/>
                            <DataGridTextColumn Header="Versão" Binding="{Binding Version, Mode=OneWay}" Width="150"/>
                            <DataGridTextColumn Header="Data" Binding="{Binding Date, Mode=OneWay}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>

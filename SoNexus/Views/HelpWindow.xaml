<Window x:Class="SoNexus.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Documentação do SoNexus" Width="860" Height="650" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource BgBrush}"
        Loaded="OnLoaded">
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top" Text="Documentação do SoNexus" Style="{StaticResource H1}" Margin="0,0,0,12"/>
        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Content="Fechar" IsCancel="True" Margin="0,12,0,0"/>
        <TabControl>
            <TabItem Header="Guia de uso">
                <TextBox x:Name="GuideText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Padding="14" FontSize="14"/>
            </TabItem>
            <TabItem Header="DLLs da instalação">
                <DockPanel Margin="8">
                    <TextBlock x:Name="InventoryStatus" DockPanel.Dock="Top" Style="{StaticResource Muted}"
                               Margin="0,0,0,8" TextWrapping="Wrap" Text="Lendo os arquivos da instalação..."/>
                    <TextBox x:Name="FilterBox" DockPanel.Dock="Top" Margin="0,0,0,8"
                             TextChanged="Filter_Changed" AutomationProperties.Name="Buscar por DLL, pacote ou descrição"/>
                    <DataGrid x:Name="InventoryList" AutoGenerateColumns="False" IsReadOnly="True"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True" CanUserAddRows="False"
                              SelectionMode="Extended">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Arquivo" Binding="{Binding File}" Width="220"/>
                            <DataGridTextColumn Header="Pacote e versão" Binding="{Binding Package}" Width="210"/>
                            <DataGridTextColumn Header="Versão do arquivo" Binding="{Binding Version}" Width="130"/>
                            <DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

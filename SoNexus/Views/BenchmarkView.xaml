<UserControl x:Class="SoNexus.Views.BenchmarkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Benchmark de CPU" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Renderiza uma cena fractal em todos os núcleos (multi-core) e depois em um só (single-core), como o Cinebench. Feche jogos e programas pesados antes."/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Renderização -->
            <DockPanel Margin="0,0,14,0">
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock x:Name="PhaseText" Text="Pronto para começar" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="LiveText" HorizontalAlignment="Right" Style="{StaticResource Muted}" FontSize="13"/>
                        </Grid>
                        <ProgressBar x:Name="PhaseBar" Style="{StaticResource Meter}" Margin="0,10,0,14"/>
                        <WrapPanel x:Name="StartBar">
                            <Button Content="Teste completo" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="Full_Click"/>
                            <Button Content="Só multi-core" Margin="0,0,8,0" Click="Multi_Click"/>
                            <Button Content="Só single-core" Margin="0,0,8,0" Click="Single_Click"/>
                        </WrapPanel>
                        <Button x:Name="StopButton" Content="Parar" Visibility="Collapsed" HorizontalAlignment="Left" Click="Stop_Click"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="8" Background="#000000">
                    <Image x:Name="RenderImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
            </DockPanel>

            <!-- Resultados -->
            <DockPanel Grid.Column="1">
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="MULTI-CORE" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="MultiText" Text="—" FontSize="40" FontWeight="SemiBold"/>
                        <TextBlock Text="SINGLE-CORE" Foreground="{StaticResource Accent2Brush}" FontSize="11" FontWeight="Bold" Margin="0,12,0,0"/>
                        <TextBlock x:Name="SingleText" Text="—" FontSize="40" FontWeight="SemiBold"/>
                        <TextBlock x:Name="RatioText" Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Histórico" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="HistoryList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DateText}" Style="{StaticResource Muted}" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="{Binding MultiText}" Foreground="{StaticResource AccentBrush}" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="2" Text="{Binding SingleText}" Foreground="{StaticResource Accent2Brush}" TextAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>

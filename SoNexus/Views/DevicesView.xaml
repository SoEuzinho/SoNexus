<UserControl x:Class="SoNexus.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,14,14">
            <StackPanel Margin="0,0,420,0">
                <TextBlock Text="Drivers dos dispositivos" Style="{StaticResource H1}"/>
                <TextBlock x:Name="Status" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Bluetooth, Wi-Fi, rede, áudio, chipset, USB, controles e todo o resto, com busca de atualizações."/>
            </StackPanel>
            <StackPanel x:Name="Bar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Procurar atualizações" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="Search_Click"/>
                <Button x:Name="InstallAllButton" Content="Instalar todas" IsEnabled="False" Margin="0,0,8,0" Click="InstallAll_Click"/>
                <Button Content="Gerenciador" Click="DeviceManager_Click"/>
            </StackPanel>
        </Grid>

        <Border x:Name="BoardCard" DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,14,12" Padding="16,12">
            <Grid>
                <StackPanel Margin="0,0,240,0">
                    <TextBlock x:Name="BoardTitle" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="Os drivers mais novos de chipset, Wi-Fi, Bluetooth, rede e áudio da placa-mãe ficam no site do fabricante. O botão abre o site e copia o modelo para você colar na busca."/>
                </StackPanel>
                <Button x:Name="BoardButton" Content="Site do fabricante" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Board_Click"/>
            </Grid>
        </Border>

        <CheckBox x:Name="ShowGeneric" DockPanel.Dock="Top" Content="Mostrar drivers genéricos do Windows" Margin="0,0,0,10" Click="Filter_Click"/>

        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,14,0">
            <DataGrid x:Name="DeviceGrid" RowHeight="NaN" MinRowHeight="32">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Margin="12,14,0,6" FontWeight="SemiBold" FontSize="14">
                                    <Run Text="{Binding Name, Mode=OneWay}"/> <Run Text="{Binding ItemCount, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/>
                                </TextBlock>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Dispositivo" Binding="{Binding Name, Mode=OneWay}" Width="*"/>
                    <DataGridTextColumn Header="Fabricante do driver" Binding="{Binding Provider, Mode=OneWay}" Width="170"/>
                    <DataGridTextColumn Header="Versão" Binding="{Binding Version, Mode=OneWay}" Width="130"/>
                    <DataGridTextColumn Header="Data" Binding="{Binding DateText, Mode=OneWay}" Width="90"/>
                    <DataGridTextColumn Header="Situação" Binding="{Binding Status, Mode=OneWay}" Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Atualização" Width="260">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <TextBlock Text="{Binding UpdateText}" TextWrapping="Wrap" Margin="0,0,74,0" FontSize="12"/>
                                    <Button Content="Instalar" Padding="10,3" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Tag="{Binding}" Click="InstallOne_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>

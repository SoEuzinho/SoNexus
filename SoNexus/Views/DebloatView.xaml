<UserControl x:Class="SoNexus.Views.DebloatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <CollectionViewSource x:Key="TweakGroups">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,14,14">
            <StackPanel Margin="0,0,330,0">
                <TextBlock Text="Debloat do Windows" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Remove propaganda, telemetria, IA e apps desnecessários. Cada ajuste guarda o valor original e pode ser revertido."/>
            </StackPanel>
            <StackPanel x:Name="TopBar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Importar" Margin="0,0,8,0" Click="Import_Click"/>
                <Button Content="Exportar" Margin="0,0,8,0" Click="Export_Click"/>
                <Button Content="Aplicar padrão recomendado" Style="{StaticResource PrimaryButton}" Click="Default_Click"/>
            </StackPanel>
        </Grid>

        <!-- Créditos -->
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,14,0" TextWrapping="Wrap"
                   Text="Ajustes e lista de apps baseados no projeto Win11Debloat, de Raphire (github.com/Raphire/Win11Debloat), licença MIT."/>

        <!-- Registro de ações -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,14,14,0" Padding="14,10" Height="110">
            <TextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                     FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </Border>

        <TabControl>
            <TabItem Header="Ajustes do sistema">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,14,12">
                        <WrapPanel x:Name="TweakBar">
                            <Button Content="Aplicar selecionados" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="Apply_Click"/>
                            <Button Content="Reverter selecionados" Margin="0,0,8,0" Click="Revert_Click"/>
                            <Button Content="Selecionar recomendados" Margin="0,0,8,0" Click="Recommended_Click"/>
                            <Button Content="Ponto de restauração" Margin="0,0,8,0" Click="Restore_Click"/>
                            <Button Content="Reiniciar Explorer" Click="Explorer_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="TweakStatus" Style="{StaticResource Muted}" FontSize="13" Margin="0,10,0,0"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Source={StaticResource TweakGroups}}">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="2,14,0,8">
                                                <Run Text="{Binding Name, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/>
                                                <Run Text="{Binding ItemCount, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="14,11" Margin="0,0,14,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}"
                                                      VerticalAlignment="Center" Margin="0,0,14,0"/>
                                            <StackPanel Grid.Column="1">
                                                <WrapPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                                                    <Border Background="{Binding RiskBrush}" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RiskText}" FontSize="9.5" FontWeight="Bold" Foreground="#000000"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding RecommendedText}" Foreground="White" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                </WrapPanel>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12.5"
                                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="Apps pré-instalados">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,14,12">
                        <TextBlock x:Name="AppsStatus" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,420,0" TextWrapping="Wrap"/>
                        <WrapPanel x:Name="AppBar" HorizontalAlignment="Right">
                            <Button Content="Atualizar lista" Margin="0,0,8,0" Click="ReloadApps_Click"/>
                            <Button Content="Selecionar padrão" Margin="0,0,8,0" Click="SelectDefaultApps_Click"/>
                            <Button Content="Remover selecionados" Style="{StaticResource PrimaryButton}" Click="RemoveApps_Click"/>
                        </WrapPanel>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="AppList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" VerticalAlignment="Top"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="14,10" Margin="0,0,14,8">
                                        <Grid>
                                            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,130,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Friendly}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Name, Mode=OneWay}"/> <Run Text="{Binding Version, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </CheckBox>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="4" Padding="6,1"
                                                    BorderThickness="1" BorderBrush="{Binding RecBrush}">
                                                <TextBlock Text="{Binding RecText}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding RecBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>

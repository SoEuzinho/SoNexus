<UserControl x:Class="SoNexus.Views.NetworkAppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Aplicativos e conexões" Style="{StaticResource H1}"/>
            <TextBlock x:Name="Status" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Quanto cada programa baixa e envia, e com quais servidores ele está conversando."/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,14,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Programas usando a internet" Style="{StaticResource H2}" Margin="16,14,0,8"/>
                    <DataGrid x:Name="AppGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Programa" Binding="{Binding Name, Mode=OneWay}" Width="200"/>
                            <DataGridTextColumn Header="Agora" Binding="{Binding RateText, Mode=OneWay}" Width="220"/>
                            <DataGridTextColumn Header="Recebido" Binding="{Binding ReceivedText, Mode=OneWay}" Width="110"/>
                            <DataGridTextColumn Header="Enviado" Binding="{Binding SentText, Mode=OneWay}" Width="110"/>
                            <DataGridTextColumn Header="Conexões" Binding="{Binding Connections, Mode=OneWay}" Width="90"/>
                            <DataGridTextColumn Header="Local do arquivo" Binding="{Binding Path, Mode=OneWay}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,0,14,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="16,14,16,8">
                        <TextBlock Text="Conexões abertas" Style="{StaticResource H2}"/>
                        <CheckBox x:Name="ShowAll" Content="Mostrar portas abertas e conexões locais" HorizontalAlignment="Right" Click="ShowAll_Click"/>
                    </Grid>
                    <DataGrid x:Name="ConnGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Programa" Binding="{Binding Process, Mode=OneWay}" Width="170"/>
                            <DataGridTextColumn Header="Servidor" Binding="{Binding Host, Mode=OneWay}" Width="*"/>
                            <DataGridTextColumn Header="Endereço remoto" Binding="{Binding Remote, Mode=OneWay}" Width="230"/>
                            <DataGridTextColumn Header="Local" Binding="{Binding Local, Mode=OneWay}" Width="200"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding State, Mode=OneWay}" Width="170"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>

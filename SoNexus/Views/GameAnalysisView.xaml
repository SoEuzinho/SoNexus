<UserControl x:Class="SoNexus.Views.GameAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,0">
            <TextBlock Text="Seu PC para jogos" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,20" TextWrapping="Wrap"
                       Text="Compare partidas registradas e consulte estimativas por resolução para o seu hardware."/>

            <UniformGrid Columns="3">
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="PLACA DE VÍDEO" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="GpuName" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar x:Name="GpuBar" Style="{StaticResource Meter}" Foreground="White" Maximum="700" Margin="0,10,0,6"/>
                        <TextBlock x:Name="GpuText" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="PROCESSADOR" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="CpuName" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar x:Name="CpuBar" Style="{StaticResource Meter}" Foreground="White" Maximum="220" Margin="0,10,0,6"/>
                        <TextBlock x:Name="CpuText" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="MONITOR E MEMÓRIA" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="MonitorText" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <TextBlock x:Name="RamText" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Medido de verdade: vem das partidas gravadas em FPS ao vivo -->
            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="TELEMETRIA DAS SUAS PARTIDAS" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="MeasuredStatus" Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="Nenhuma partida registrada. Inicie a medição em Jogos › FPS ao vivo e jogue por pelo menos 30 segundos."/>
                    <ItemsControl x:Name="MeasuredList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Game}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding When}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="SINAL MAIS FREQUENTE" Style="{StaticResource Label}"/>
                                        <TextBlock FontWeight="SemiBold"><Run Text="{Binding Main, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding MainPct, Mode=OneWay, StringFormat={}{0:0}%}" Foreground="{StaticResource MutedBrush}"/></TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="Comparar duas partidas" Style="{StaticResource H2}"/>
                    <TextBlock x:Name="ComparisonStatus" Style="{StaticResource Muted}" Margin="0,4,0,8" TextWrapping="Wrap"/>
                    <StackPanel x:Name="ComparisonControls" Visibility="Collapsed">
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Partida A" Foreground="#59D9E9"/>
                                <ComboBox x:Name="FirstSession" DisplayMemberPath="ComparisonLabel" SelectionChanged="FirstSession_Changed"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Partida B" Foreground="#F0BB78"/>
                                <ComboBox x:Name="SecondSession" DisplayMemberPath="ComparisonLabel" SelectionChanged="Comparison_Changed"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Métrica" Style="{StaticResource Muted}"/>
                                <ComboBox x:Name="TimelineMetric" SelectedIndex="0" SelectionChanged="Comparison_Changed">
                                    <ComboBoxItem Content="Menor FPS por intervalo"/>
                                    <ComboBoxItem Content="Pico de temperatura da CPU"/>
                                    <ComboBoxItem Content="Pico de temperatura da GPU"/>
                                    <ComboBoxItem Content="Engasgos estimados por intervalo"/>
                                </ComboBox>
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock x:Name="ComparisonSummary" Margin="0,8,0,6" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TimelineScale" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                        <Viewbox Stretch="Fill" Height="105" Margin="0,4,0,0">
                            <Canvas Width="600" Height="100" Background="#151515" ClipToBounds="True">
                                <Line X2="600" Y1="50" Y2="50" Stroke="#363636"/>
                                <Path x:Name="FirstPlot" Stroke="#59D9E9" StrokeThickness="1.6"/>
                                <Path x:Name="SecondPlot" Stroke="#F0BB78" StrokeThickness="1.6"/>
                            </Canvas>
                        </Viewbox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="GARGALO ESTIMADO POR RESOLUÇÃO" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Modelo aproximado de um jogo pesado genérico. As barras mostram proporções calculadas a partir de tabelas de hardware."/>
                    <ItemsControl x:Name="BottleneckList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Resolution}" FontSize="16" FontWeight="Light" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                        <TextBlock Text="LIMITE" Style="{StaticResource Label}"/>
                                        <TextBlock Text="{Binding Limit}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding GpuUseText}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                        <ProgressBar Style="{StaticResource Meter}" Foreground="White" Maximum="100" Value="{Binding GpuUse, Mode=OneWay}" Margin="0,2,0,6"/>
                                        <TextBlock Text="{Binding CpuUseText}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                        <ProgressBar Style="{StaticResource Meter}" Foreground="White" Maximum="100" Value="{Binding CpuUse, Mode=OneWay}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding Text}" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Top"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="BottleneckStatus" Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="O QUE ESTÁ SEGURANDO O SEU PC" Style="{StaticResource Label}" Margin="0,0,0,10"/>
                    <ItemsControl x:Name="TipList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource MutedBrush}" Padding="6,1" VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Impact}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Corrigir" Padding="12,4" VerticalAlignment="Center" Tag="{Binding}" Click="Fix_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Fix}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="TipStatus" Style="{StaticResource Muted}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="PROBLEMAS NOS JOGOS" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Jogos que fecharam sozinhos nos últimos 30 dias (registrado pelo Windows), bibliotecas que faltam, instalações quebradas e discos cheios."/>
                    <ItemsControl x:Name="ProblemList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource MutedBrush}" Padding="6,1" VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Severity}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="ProblemStatus" Style="{StaticResource Muted}" Text="Procurando..."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

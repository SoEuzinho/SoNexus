<UserControl x:Class="SoNexus.Views.RgbView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="15" Background="{TemplateBinding Background}" BorderBrush="#333333" BorderThickness="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Botão de escolha (efeito, cor 1/2): preto com borda; escolhido = branco. -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="16" BorderThickness="1" BorderBrush="{StaticResource LineBrush}" Background="Transparent" Padding="12,6">
                            <ContentPresenter x:Name="cp"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#777777"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="White"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="White"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <LinearGradientBrush x:Key="HueBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF0000" Offset="0"/>
            <GradientStop Color="#FFFF00" Offset="0.1667"/>
            <GradientStop Color="#00FF00" Offset="0.3333"/>
            <GradientStop Color="#00FFFF" Offset="0.5"/>
            <GradientStop Color="#0000FF" Offset="0.6667"/>
            <GradientStop Color="#FF00FF" Offset="0.8333"/>
            <GradientStop Color="#FF0000" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,14,16">
            <StackPanel Margin="0,0,160,0">
                <TextBlock Text="Iluminação RGB" Style="{StaticResource H1}"/>
                <TextBlock x:Name="Status" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Button x:Name="ConnectButton" Content="Conectar" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Click="Connect_Click"/>
        </Grid>

        <!-- Prévia animada: mostra o efeito como ele fica numa fita/ventoinha, mesmo sem OpenRGB. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,14,14" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Text="PRÉVIA" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="PreviewName" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="10" Background="#050505" Padding="10,8" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <UniformGrid x:Name="LedStrip" Rows="1"/>
                </Border>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,14,0">
                <StackPanel x:Name="ControlsPanel" IsEnabled="False">
                    <!-- Efeito -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="EFEITO" Style="{StaticResource Label}"/>
                            <WrapPanel x:Name="EffectPanel"/>
                            <TextBlock x:Name="EffectHint" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Cor -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="COR" Style="{StaticResource Label}"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="EditColor1" Style="{StaticResource Chip}" GroupName="EditColor" IsChecked="True" Margin="0" Checked="EditColor_Changed">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="Color1Preview" Width="18" Height="18" CornerRadius="9" Margin="0,0,8,0" BorderBrush="#555555" BorderThickness="1"/>
                                        <TextBlock Text="Cor 1"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="EditColor2" Grid.Column="2" Style="{StaticResource Chip}" GroupName="EditColor" Margin="0" Checked="EditColor_Changed">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="Color2Preview" Width="18" Height="18" CornerRadius="9" Margin="0,0,8,0" BorderBrush="#555555" BorderThickness="1"/>
                                        <TextBlock Text="Cor 2"/>
                                    </StackPanel>
                                </RadioButton>
                            </Grid>

                            <Border x:Name="Preview" Height="40" CornerRadius="8" Background="White" Margin="0,0,0,12"/>
                            <TextBlock Text="Tom" Style="{StaticResource Muted}"/>
                            <Border CornerRadius="4" Background="{StaticResource HueBrush}" Height="8" Margin="0,4,0,0"/>
                            <Slider x:Name="HueSlider" Maximum="360" Margin="0,-14,0,6" ValueChanged="Hsv_Changed"/>
                            <TextBlock Text="Intensidade da cor (0 = branco)" Style="{StaticResource Muted}"/>
                            <Slider x:Name="SatSlider" Maximum="1" Value="1" Margin="0,2,0,10" ValueChanged="Hsv_Changed"/>

                            <WrapPanel>
                                <Button Style="{StaticResource Swatch}" Background="White" Tag="FFFFFF" Click="Swatch_Click" ToolTip="Branco"/>
                                <Button Style="{StaticResource Swatch}" Background="#FF0000" Tag="FF0000" Click="Swatch_Click" ToolTip="Vermelho"/>
                                <Button Style="{StaticResource Swatch}" Background="#FF6A00" Tag="FF6A00" Click="Swatch_Click" ToolTip="Laranja"/>
                                <Button Style="{StaticResource Swatch}" Background="#FFD000" Tag="FFD000" Click="Swatch_Click" ToolTip="Amarelo"/>
                                <Button Style="{StaticResource Swatch}" Background="#00FF40" Tag="00FF40" Click="Swatch_Click" ToolTip="Verde"/>
                                <Button Style="{StaticResource Swatch}" Background="#00D0FF" Tag="00D0FF" Click="Swatch_Click" ToolTip="Ciano"/>
                                <Button Style="{StaticResource Swatch}" Background="#0040FF" Tag="0040FF" Click="Swatch_Click" ToolTip="Azul"/>
                                <Button Style="{StaticResource Swatch}" Background="#A000FF" Tag="A000FF" Click="Swatch_Click" ToolTip="Roxo"/>
                                <Button Style="{StaticResource Swatch}" Background="#FF00A0" Tag="FF00A0" Click="Swatch_Click" ToolTip="Rosa"/>
                            </WrapPanel>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Código #" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="HexBox" Grid.Column="1" MaxLength="7" KeyDown="Hex_KeyDown" LostFocus="Hex_LostFocus"/>
                                <Button Grid.Column="2" Content="★ Salvar favorita" HorizontalAlignment="Right" Click="AddFavorite_Click"/>
                            </Grid>
                            <TextBlock Text="FAVORITAS" Style="{StaticResource Label}" Margin="0,12,0,6"/>
                            <WrapPanel x:Name="FavoritePanel"/>
                            <TextBlock x:Name="FavoriteHint" Style="{StaticResource Muted}" Text="Nenhuma ainda. Escolha uma cor e clique em ★. Clique com o botão direito numa favorita para remover." TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Ajustes -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="AJUSTES" Style="{StaticResource Label}"/>
                            <Grid>
                                <TextBlock Text="Brilho" Style="{StaticResource Muted}"/>
                                <TextBlock x:Name="BrightText" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="BrightSlider" Minimum="0" Maximum="100" Margin="0,2,0,10" ValueChanged="Tuning_Changed"/>
                            <Grid>
                                <TextBlock Text="Velocidade dos efeitos" Style="{StaticResource Muted}"/>
                                <TextBlock x:Name="SpeedText" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SpeedSlider" Minimum="0.2" Maximum="3" Margin="0,2,0,10" ValueChanged="Tuning_Changed"/>
                            <CheckBox x:Name="RestoreBox" Content="Reaplicar esta iluminação ao abrir o SoNexus" Click="Restore_Click"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="26,2,0,0" TextWrapping="Wrap"
                                       Text="Os efeitos do SoNexus continuam rodando com o app na bandeja. Para a cor ficar mesmo com o PC desligado ou o app fechado, use um modo da própria placa (ao lado) e clique em Salvar na placa."/>
                        </StackPanel>
                    </Border>

                    <!-- Programas do fabricante -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="PROGRAMAS DE RGB NO PC" Style="{StaticResource Label}"/>
                            <ItemsControl x:Name="AppList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="AppWarning" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <Button Content="Pausar programas do fabricante" HorizontalAlignment="Left" Margin="0,10,0,0" Click="StopVendor_Click"/>
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"
                                       Text="A ventoinha não muda? Se está num hub com controle remoto/botão próprio, nenhum programa controla: ligue o cabo ARGB (3 pinos, 5 V) direto na placa-mãe. Ventoinhas de 4 pinos 12 V RGB só aceitam uma cor para todas."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Dispositivos e modos da própria placa -->
            <DockPanel Grid.Column="1" Margin="0,0,14,0">
                <!-- Fitas Bluetooth (BJ_LED): funcionam sem o OpenRGB. -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="FITAS DE LED BLUETOOTH" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            <Button x:Name="BleScanButton" Content="Procurar fitas" HorizontalAlignment="Right" Click="BleScan_Click"/>
                        </Grid>
                        <TextBlock x:Name="BleStatus" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,6"
                                   Text="Fitas BJ_LED (app MohuanLED). Ligue a fita, feche o app no celular (ela aceita uma conexão por vez) e clique em Procurar."/>
                        <ItemsControl x:Name="BleList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Top" Click="BleToggle_Click"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Esquecer" Padding="10,3" VerticalAlignment="Top" Tag="{Binding}" Click="BleForget_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" x:Name="HwCard" Style="{StaticResource Card}" Margin="0,12,0,0" IsEnabled="False">
                    <StackPanel>
                        <TextBlock Text="MODOS DA PRÓPRIA PLACA" Style="{StaticResource Label}"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="Efeitos que rodam dentro do aparelho, sem o SoNexus. Usam a Cor 1, a Cor 2 e a velocidade escolhidas aqui (quando o modo aceita)."/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="HwDeviceBox" DisplayMemberPath="Name" SelectionChanged="HwDevice_Changed"/>
                            <ComboBox x:Name="HwModeBox" Grid.Column="2" SelectionChanged="HwMode_Changed"/>
                        </Grid>
                        <TextBlock x:Name="HwModeInfo" Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Usar este modo" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="HwApply_Click"/>
                            <Button x:Name="HwSaveButton" Content="Salvar na placa" Margin="0,0,8,0" Click="HwSave_Click"/>
                            <Button Content="Voltar aos efeitos do SoNexus" Click="BackToSoftware_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Dispositivos com LED" Style="{StaticResource H2}" Margin="16,14,0,4"/>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="16,0,16,10" TextWrapping="Wrap"
                                   Text="Desmarque o que não deve receber os efeitos."/>
                        <TextBlock x:Name="HowTo" DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="16,0,16,10" TextWrapping="Wrap"
                                   Text="Para controlar os LEDs: 1) instale o OpenRGB (openrgb.org, gratuito); 2) abra-o como administrador (necessário para placa-mãe e RAM) e vá em SDK Server; 3) clique em Start Server (marque para iniciar sozinho); 4) clique em Conectar aqui. Feche o Armoury Crate/iCUE antes para eles não brigarem pelo controle."/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="DeviceList" Margin="16,0,16,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Top" Click="DeviceToggle_Click"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Device.Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Device.Type}" Style="{StaticResource Muted}" Margin="10,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>

<UserControl x:Class="SoNexus.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SoNexus.Controls"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
        <DataTemplate x:Key="KeyValue">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Key}" Style="{StaticResource Muted}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,0">
            <TextBlock Text="Rede" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,20"
                       Text="Como o PC está conectado, quem é a operadora e se a conexão está boa."/>

            <UniformGrid Columns="3">
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="CONEXÃO" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="ConnType" Text="—" FontSize="26" FontWeight="Light" Margin="0,2,0,0"/>
                        <TextBlock x:Name="ConnDetail" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="IP PÚBLICO E OPERADORA" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="PublicIp" Text="consultando..." FontSize="26" FontWeight="Light" Margin="0,2,0,0"/>
                        <TextBlock x:Name="PublicDetail" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="VELOCIDADE AGORA" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="SpeedNow" Text="—" FontSize="26" FontWeight="Light" Margin="0,2,0,0"/>
                        <TextBlock x:Name="SpeedDetail" Style="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="TRÁFEGO (MBPS)" Style="{StaticResource Label}"/>
                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource Muted}">
                            <Run Text="━ download" Foreground="White"/>   <Run Text="━ upload" Foreground="#8C8C8C"/>
                        </TextBlock>
                    </Grid>
                    <Grid Height="120" Margin="0,10,0,0">
                        <c:LineChart x:Name="DownChart" Unit="" Capacity="120"/>
                        <c:LineChart x:Name="UpChart" Unit="" Capacity="120" Opacity="0.8"/>
                    </Grid>
                </StackPanel>
            </Border>

            <UniformGrid Columns="2">
                <Border Style="{StaticResource Card}" Margin="0,0,12,12" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="ENDEREÇOS" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="AddressList" ItemTemplate="{StaticResource KeyValue}"/>
                    </StackPanel>
                </Border>
                <Border x:Name="WifiCard" Style="{StaticResource Card}" Margin="0,0,12,12" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="WI-FI" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="WifiList" ItemTemplate="{StaticResource KeyValue}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="QUALIDADE DA CONEXÃO" Style="{StaticResource Label}"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                                       Text="Ping até o roteador mostra o Wi-Fi/cabo; até a internet mostra a operadora. Jitter alto e perda de pacotes causam lag em jogos."/>
                        </StackPanel>
                        <Button x:Name="PingButton" Content="Testar conexão" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="Ping_Click"/>
                    </Grid>
                    <DataGrid x:Name="PingGrid" MinHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Destino" Binding="{Binding Target, Mode=OneWay}" Width="*"/>
                            <DataGridTextColumn Header="Endereço" Binding="{Binding Address, Mode=OneWay}" Width="160"/>
                            <DataGridTextColumn Header="Ping" Binding="{Binding AvgText, Mode=OneWay}" Width="110"/>
                            <DataGridTextColumn Header="Jitter" Binding="{Binding JitterText, Mode=OneWay}" Width="90"/>
                            <DataGridTextColumn Header="Perda" Binding="{Binding LossText, Mode=OneWay}" Width="70"/>
                            <DataGridTextColumn Header="Avaliação" Binding="{Binding Quality, Mode=OneWay}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

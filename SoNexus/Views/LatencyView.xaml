<UserControl x:Class="SoNexus.Views.LatencyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SoNexus.Controls">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel Margin="0,0,200,0">
                <TextBlock Text="Latência (DPC / ISR)" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Mede atrasos do Windows e descobre qual driver causa travadinhas, estalos no áudio ou input lag, como o LatencyMon. Deixe rodando enquanto usa o PC ou joga."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="StartButton" Content="Iniciar medição" Style="{StaticResource PrimaryButton}" Click="Start_Click"/>
                <Button x:Name="StopButton" Content="Parar" Visibility="Collapsed" Click="Stop_Click"/>
            </StackPanel>
        </Grid>

        <Border x:Name="Verdict" DockPanel.Dock="Top" Margin="0,0,14,14" BorderThickness="1" CornerRadius="10" Padding="14,10"
                Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}">
            <TextBlock x:Name="VerdictText" TextWrapping="Wrap" FontWeight="SemiBold" Text="Clique em Iniciar medição."/>
        </Border>

        <UniformGrid DockPanel.Dock="Top" Columns="4">
            <Border Style="{StaticResource Card}" Margin="0,0,14,14">
                <StackPanel>
                    <TextBlock Text="LATÊNCIA MÁXIMA" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="TimerMaxText" Text="—" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="maior tempo que o Windows travou um programa" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,14,14">
                <StackPanel>
                    <TextBlock Text="ATRASO MÉDIO" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="TimerAvgText" Text="—" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TimerDetail" Style="{StaticResource Muted}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,14,14">
                <StackPanel>
                    <TextBlock Text="DPC MAIS LONGO" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="DpcText" Text="—" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DpcDriver" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,14,14">
                <StackPanel>
                    <TextBlock Text="ISR MAIS LONGO" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="IsrText" Text="—" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock x:Name="IsrDriver" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,14,14" Height="170">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Pior latência a cada segundo" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                <c:LineChart x:Name="LatencyChart" Unit="µs" Capacity="180"/>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,14,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Drivers (do pior para o melhor)" Style="{StaticResource H2}" Margin="16,14,0,8"/>
                <DataGrid x:Name="DriverGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Driver" Binding="{Binding Driver, Mode=OneWay}" Width="150"/>
                        <DataGridTextColumn Header="Descrição" Binding="{Binding Description, Mode=OneWay}" Width="*"/>
                        <DataGridTextColumn Header="Situação" Binding="{Binding Level, Mode=OneWay}" Width="90"/>
                        <DataGridTextColumn Header="DPC máx" Binding="{Binding DpcMaxText, Mode=OneWay}" Width="90"/>
                        <DataGridTextColumn Header="DPCs" Binding="{Binding DpcCount, Mode=OneWay}" Width="90"/>
                        <DataGridTextColumn Header="Tempo DPC" Binding="{Binding DpcTotalText, Mode=OneWay}" Width="100"/>
                        <DataGridTextColumn Header="ISR máx" Binding="{Binding IsrMaxText, Mode=OneWay}" Width="90"/>
                        <DataGridTextColumn Header="ISRs" Binding="{Binding IsrCount, Mode=OneWay}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>

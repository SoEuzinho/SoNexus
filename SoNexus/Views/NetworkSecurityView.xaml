<UserControl x:Class="SoNexus.Views.NetworkSecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,14,16">
            <StackPanel Margin="0,0,180,0">
                <TextBlock Text="Segurança da rede" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Procura sinais de invasão: acesso remoto, portas de programas maliciosos, programas desconhecidos usando a internet e envio exagerado de dados. Não substitui o antivírus."/>
            </StackPanel>
            <Button x:Name="AnalyzeButton" Content="Analisar agora" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="Analyze_Click"/>
        </Grid>

        <Border x:Name="Verdict" DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,14,14" Padding="14,10">
            <TextBlock x:Name="VerdictText" TextWrapping="Wrap" FontWeight="SemiBold" Text="Analisando..."/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="AlertList" Margin="0,0,14,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="badge" CornerRadius="4" Padding="6,2" VerticalAlignment="Top" HorizontalAlignment="Left"
                                        BorderThickness="1" BorderBrush="{StaticResource MutedBrush}">
                                    <TextBlock x:Name="sev" Text="{Binding Severity}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Severity}" Value="Alta">
                                <Setter TargetName="badge" Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                <Setter TargetName="sev" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Média">
                                <Setter TargetName="badge" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="sev" Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>

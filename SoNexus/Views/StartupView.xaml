<UserControl x:Class="SoNexus.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Inicialização" Style="{StaticResource H1}"/>
                <TextBlock x:Name="Status" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"
                           Text="Tudo que abre sozinho com o Windows: registro, pasta Inicializar, tarefas agendadas e serviços."/>
            </StackPanel>
        </Grid>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Grid Width="260" Margin="0,0,14,0">
                    <TextBox x:Name="FilterBox" TextChanged="Filter_Changed"/>
                    <TextBlock x:Name="FilterHint" Text="Filtrar por nome, editor ou caminho" IsHitTestVisible="False"
                               Style="{StaticResource Muted}" Margin="11,0,0,0" VerticalAlignment="Center"/>
                </Grid>
                <ComboBox x:Name="KindBox" Width="170" Margin="0,0,14,0" SelectionChanged="Filter_Changed" SelectedIndex="0">
                    <ComboBoxItem Content="Todos os tipos"/>
                    <ComboBoxItem Content="Registro"/>
                    <ComboBoxItem Content="Pasta Inicializar"/>
                    <ComboBoxItem Content="Tarefa agendada"/>
                    <ComboBoxItem Content="Serviço"/>
                </ComboBox>
                <CheckBox x:Name="ShowMicrosoft" Content="Mostrar itens da Microsoft" VerticalAlignment="Center"
                          Click="Filter_Changed"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OpenButton" Content="Abrir local do arquivo" Margin="0,0,8,0" Click="Open_Click"/>
                <Button x:Name="SearchButton" Content="Pesquisar na internet" Margin="0,0,8,0" Click="Search_Click"/>
                <Button x:Name="RefreshButton" Content="Atualizar" Style="{StaticResource PrimaryButton}" Click="Refresh_Click"/>
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="EntryGrid">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Ativo" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" IsEnabled="{Binding CanToggle}"
                                          HorizontalAlignment="Center" Click="Toggle_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Nome" Binding="{Binding Name, Mode=OneWay}" Width="220"/>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding KindName, Mode=OneWay}" Width="125"/>
                    <DataGridTextColumn Header="Editor" Binding="{Binding Publisher, Mode=OneWay}" Width="170"/>
                    <DataGridTextColumn Header="Alerta" Binding="{Binding Status, Mode=OneWay}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Comando" Binding="{Binding Command, Mode=OneWay}" Width="*"/>
                    <DataGridTextColumn Header="Local" Binding="{Binding Location, Mode=OneWay}" Width="200"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
